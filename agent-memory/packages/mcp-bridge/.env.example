# mcp-bridge v3 配置示例（占位符，勿填真实 key 提交）
# 真实值放本机 .env（已被 .gitignore 排除）或 MCP settings 的 env 字段

# MemoryCore Gateway 地址（公网或内网）
MEMORY_ENDPOINT=https://memory.kuai-private.top

# 网关门禁 key（Authorization: Bearer，多 agent 共用）
API_KEY=<gate-api-key>

# memory 实例 id / spaceId（x-tdai-service-id header）
SERVICE_ID=default

# v3 隔离三元组
TEAM_ID=<team-id>
AGENT_ID=<agent-id>
USER_ID=<user-id>

# 该 agent 的 user_key（可选，meta 面鉴权用）
# USER_KEY=<agent-user-key>

# task_id（可选）：项目级隔离标签（如项目名）。未设则自动从项目路径（cwd 目录名）派生。
# ⚠️ 不要填身份 id（AGT_ID/TEAM_ID/USER_ID/key，agt-/team-/usr-/sk- 前缀）——0.4.0 起启动即拒绝。
# TASK_ID=<project-name>

# 默认 session key（可选，缺省 = <AGENT_ID>-<YYYY-MM-DD>）
# SESSION_KEY=

# 超时（毫秒，可选，默认 15000）
# TIMEOUT_MS=15000
