# agent-memory 接入的环境变量与取值说明（模板；不要提交真实值）
#
# 这些值最终填在 %DSH_HOME%/profiles/web/cordis.patch.yml 的对应 env 下
# （install.sh / install.ps1 会生成带占位符的条目）。真实取值来自 Memory Panel
# 团队记忆控制台（http://127.0.0.1:8123）或团队管理员。

# --- v3 身份三元组 + 团队 key（L1 隔离维度）---------------------------------
TEAM_ID=team-xxxxxxxx
AGENT_ID=agt-xxxxxxxx
USER_ID=usr-xxxxxxxx

# --- 接入端点 ----------------------------------------------------------------
# 主记忆通道直连 MemoryCore v3（gateway：/v3/conversation|atomic|core|scenario）
MEMORY_ENDPOINT=http://127.0.0.1:8422
# HTTP 桥（bridge-server）与 TDAI gateway（供非 MCP 客户端/autostore 使用）
BRIDGE_URL=http://127.0.0.1:3000
TDAI_GATEWAY_URL=http://127.0.0.1:8420
# code-graph 通道（MemoryKnowledge，:8421）—— 与 MemoryCore 是**两个服务**：
# /v3/code-graph/* 只由 MemoryKnowledge 提供；把 knowledgeEndpoint 指到 MemoryCore 网关
# （含它的对外域名）只会得到 404 Not found: POST /v3/code-graph/*。
# 引擎在远端时，必须给客户端一个**可达的 Knowledge 地址**（如 https://knowledge.<域名>），
# 不能用 memory.<域名>（那只是 MemoryCore 网关）。见 README「远端部署」。
KNOWLEDGE_ENDPOINT=http://127.0.0.1:8421

# --- 密钥：引用式（推荐）------------------------------------------------------
# cordis.patch.yml 里只写引用名，真值存受管凭证库 %DSH_HOME%/.credentials.yaml 的 refs: 段：
#   AGENT_MEMORY_API_KEY   —— 网关门禁 key（Authorization: Bearer；bridge-server 侧放 sha256 哈希）
#   AGENT_MEMORY_USER_KEY  —— 团队记忆 key（sk-mem-…）
# 存法：会话里 credentials_set <REF> <值>，或直接编辑该文件（0600、原子写、热生效）。
# 解析优先级：凭证 seam（ref）> 同名环境变量 > 内联 apiKey/userKey（切换期兜底）。
AGENT_MEMORY_API_KEY=<store-in-credentials-yaml>
AGENT_MEMORY_USER_KEY=<store-in-credentials-yaml>
# 仅当 Knowledge 网关接受的 key 与 MemoryCore 不同才需要（如 AGENT_MEMORY_KNOWLEDGE_KEY）；
# 未配置时 code-graph 复用 apiKey/apiKeyRef。两个通道都会发 Authorization: Bearer。
# AGENT_MEMORY_KNOWLEDGE_KEY=<store-in-credentials-yaml>
SERVICE_ID=default

# --- 会话入库标签 ------------------------------------------------------------
# L1 事实的项目标签（一个项目一个 task_id；Agent 侧 recall 按它隔离）
TASK_ID=<project label>

# --- 引擎侧 LLM（记忆提炼用；不写进仓库）------------------------------------
# 放 600 权限文件，由 templates/engine/start-gateway-full.sh 读取：
#   ~/.config/memory-gateway/llm_key.txt          (TDAI_LLM_API_KEY)
#   ~/.config/memory-gateway/embedding_key.txt    (TDAI_EMBEDDING_API_KEY)
TDAI_LLM_BASE_URL=https://api.deepseek.com/v1
TDAI_LLM_MODEL=deepseek-flash
